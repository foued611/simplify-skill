@@ -10,3 +10,14 @@ export function routeLength(segments) {
 export function routeKm(segments) {
   return toKm(routeLength(segments))
 }
+
+// label-rule: the label always shows kilometers with one decimal so the
+// summary reads the same on every screen.
+export function routeLabel(segments, verbose = false) {
+  const km = routeKm(segments).toFixed(1)
+  if (verbose) return `Route: ${km} km (${segments.length} segments)`
+  return `Route: ${km} km`
+}
